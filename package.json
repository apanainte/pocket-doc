{
  "name": "pocket-doc",
  "main": "expo-router/entry",
  "version": "1.0.1",
  "private": true,
  "scripts": {
    "dev": "EXPO_NO_TELEMETRY=1 expo start",
    "start": "expo start",
    "start:clear": "expo start --clear",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "build:ios": "eas build --platform ios",
    "build:android": "eas build --platform android",
    "build:all": "eas build --platform all",
    "build:preview": "eas build --profile preview",
    "submit:ios": "eas submit --platform ios",
    "submit:android": "eas submit --platform android",
    "lint": "expo lint",
    "test": "cd tests && python run_tests.py",
    "test:ocr": "cd tests && python -c \"from test_ocr import testOCRIntegration; testOCRIntegration()\"",
    "setup:appstore": "node scripts/setup_app_store.js",
    "find:appid": "node scripts/find_app_id.js",
    "verify:phase1": "node scripts/verify_phase1.js",
    "test:startup": "node scripts/test_startup.js",
    "setup:ocr": "node scripts/setup_ocr.js",
    "test:ocr-integration": "node scripts/test_ocr_integration.js",
    "test:cloud-ocr": "node scripts/test_cloud_ocr.js",
    "test:cloud-ocr:help": "node scripts/test_cloud_ocr.js --help",
    "clean": "rm -rf node_modules package-lock.json && npm install",
    "clean:cache": "expo start --clear"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.1",
    "@expo/vector-icons": "^14.1.0",
    "@lucide/lab": "^0.1.2",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/native": "^7.0.14",
    "@sentry/react-native": "^6.17.0",
    "dotenv": "^17.2.0",
    "expo": "53.0.19",
    "expo-blur": "~14.1.5",
    "expo-camera": "~16.1.10",
    "expo-constants": "~17.1.3",
    "expo-document-picker": "^13.1.6",
    "expo-file-system": "^18.1.11",
    "expo-font": "~13.3.2",
    "expo-haptics": "~14.1.4",
    "expo-image-picker": "^16.1.4",
    "expo-linear-gradient": "~14.1.5",
    "expo-linking": "~7.1.7",
    "expo-local-authentication": "~16.0.5",
    "expo-router": "~5.1.3",
    "expo-secure-store": "~14.2.3",
    "expo-splash-screen": "~0.30.10",
    "expo-sqlite": "~15.2.14",
    "expo-status-bar": "~2.2.3",
    "expo-symbols": "~0.4.5",
    "expo-system-ui": "~5.0.10",
    "expo-web-browser": "~14.2.0",
    "lucide-react-native": "^0.475.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.5",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "^15.11.2",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.20.0",
    "react-native-webview": "13.13.5",
    "react-native-mlkit-ocr": "^0.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.0.10",
    "jest": "^30.0.4",
    "typescript": "~5.8.3"
  }
}
