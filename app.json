{
  "expo": {
    "name": "Pocket Doc",
    "slug": "pocket-doc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pocketdoc",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pocketdoc.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Pocket Doc needs camera access to capture document photos for your personal library.",
        "NSPhotoLibraryUsageDescription": "Pocket Doc needs photo library access to upload images as documents.",
        "NSFaceIDUsageDescription": "Pocket Doc uses Face ID to securely authenticate and protect your documents.",
        "NSMicrophoneUsageDescription": "Pocket Doc may need microphone access for document scanning features."
      }
    },
    "android": {
      "package": "com.pocketdoc.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router", 
      "expo-font", 
      "expo-web-browser",
      "expo-image-picker",
      "expo-document-picker",
      "expo-sqlite",
      "expo-local-authentication",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
